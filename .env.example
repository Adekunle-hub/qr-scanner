# From Meta dashboard > WhatsApp > API Setup
WHATSAPP_TOKEN=paste_temporary_or_system_user_token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
# From Meta dashboard > App settings > Basic > App secret (used to check X-Hub-Signature-256)
META_APP_SECRET=paste_app_secret
# Any string you choose; paste the same value in the webhook setup screen
WEBHOOK_VERIFY_TOKEN=choose-a-long-random-string
GRAPH_API_VERSION=v23.0
PORT=3000
